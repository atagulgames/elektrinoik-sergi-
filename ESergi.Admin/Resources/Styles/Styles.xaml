<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
  <Style TargetType="Button"><Setter Property="BackgroundColor" Value="{DynamicResource Primary}"/><Setter Property="TextColor" Value="{DynamicResource OnPrimary}"/><Setter Property="FontSize" Value="14"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="16,10"/><Setter Property="MinimumHeightRequest" Value="48"/><Setter Property="MinimumWidthRequest" Value="48"/></Style>
  <Style TargetType="Entry"><Setter Property="TextColor" Value="{DynamicResource OnSurface}"/><Setter Property="PlaceholderColor" Value="{DynamicResource OnSurfaceVariant}"/><Setter Property="MinimumHeightRequest" Value="48"/></Style>
  <Style TargetType="Editor"><Setter Property="TextColor" Value="{DynamicResource OnSurface}"/><Setter Property="PlaceholderColor" Value="{DynamicResource OnSurfaceVariant}"/></Style>
  <Style TargetType="Picker"><Setter Property="TextColor" Value="{DynamicResource OnSurface}"/><Setter Property="MinimumHeightRequest" Value="48"/></Style>
  <Style TargetType="ActivityIndicator"><Setter Property="Color" Value="{DynamicResource Primary}"/></Style>
</ResourceDictionary>
